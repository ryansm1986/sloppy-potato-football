{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "generatedAt", "citations", "insights", "rankingSnapshot", "rankingSnapshots"],
  "properties": {
    "summary": { "type": "string", "minLength": 1, "maxLength": 5000 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "citations": {
      "type": "array", "maxItems": 50,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["title", "url", "publisher", "publishedAt", "accessedAt"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 300 },
          "url": { "type": "string", "maxLength": 2000 },
          "publisher": { "type": ["string", "null"], "maxLength": 120 },
          "publishedAt": { "type": ["string", "null"], "format": "date-time" },
          "accessedAt": { "type": ["string", "null"], "format": "date-time" }
        }
      }
    },
    "insights": {
      "type": "array", "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["subject", "finding", "confidence", "citationUrls"],
        "properties": {
          "subject": { "type": "string", "minLength": 1, "maxLength": 160 },
          "finding": { "type": "string", "minLength": 1, "maxLength": 1200 },
          "confidence": { "type": ["string", "null"], "enum": ["low", "medium", "high", null] },
          "citationUrls": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 2000 } }
        }
      }
    },
    "rankingSnapshot": {
          "type": ["object", "null"], "additionalProperties": false,
          "required": ["sourceUrl", "title", "scoringFormat", "rankingType", "season", "week", "summary", "methodology", "entries"],
          "properties": {
            "sourceUrl": { "type": ["string", "null"], "maxLength": 2000 },
            "title": { "type": "string", "minLength": 3, "maxLength": 140 },
            "scoringFormat": { "type": "string", "enum": ["ppr", "half_ppr", "standard"] },
            "rankingType": { "type": "string", "enum": ["redraft", "weekly", "rest_of_season", "dynasty", "rookie"] },
            "season": { "type": "string", "pattern": "^20[0-9]{2}$" },
            "week": { "type": ["integer", "null"], "minimum": 1, "maximum": 25 },
            "summary": { "type": ["string", "null"], "maxLength": 1500 },
            "methodology": { "type": ["string", "null"], "maxLength": 2000 },
            "entries": {
              "type": "array", "minItems": 1, "maxItems": 500,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["playerName", "position", "team", "rank", "previousRank", "tier", "insight"],
                "properties": {
                  "playerName": { "type": "string", "minLength": 2, "maxLength": 120 },
                  "position": { "type": ["string", "null"], "maxLength": 10 },
                  "team": { "type": ["string", "null"], "maxLength": 5 },
                  "rank": { "type": "integer", "minimum": 1, "maximum": 500 },
                  "previousRank": { "type": ["integer", "null"], "minimum": 1, "maximum": 500 },
                  "tier": { "type": ["integer", "null"], "minimum": 1, "maximum": 100 },
                  "insight": { "type": ["string", "null"], "maxLength": 600 }
                }
              }
            }
          }
    },
    "rankingSnapshots": {
      "type": ["array", "null"],
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceName", "sourceUrl", "title", "scoringFormat", "rankingType", "season", "week", "summary", "methodology", "entries"],
        "properties": {
          "sourceName": { "type": "string", "minLength": 2, "maxLength": 100 },
          "sourceUrl": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "title": { "type": "string", "minLength": 3, "maxLength": 140 },
          "scoringFormat": { "type": "string", "enum": ["ppr", "half_ppr", "standard"] },
          "rankingType": { "type": "string", "enum": ["redraft", "weekly", "rest_of_season", "dynasty", "rookie"] },
          "season": { "type": "string", "pattern": "^20[0-9]{2}$" },
          "week": { "type": ["integer", "null"], "minimum": 1, "maximum": 25 },
          "summary": { "type": ["string", "null"], "maxLength": 1500 },
          "methodology": { "type": ["string", "null"], "maxLength": 2000 },
          "entries": {
            "type": "array",
            "minItems": 1,
            "maxItems": 500,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["playerName", "position", "team", "rank", "previousRank", "tier", "insight"],
              "properties": {
                "playerName": { "type": "string", "minLength": 2, "maxLength": 120 },
                "position": { "type": ["string", "null"], "maxLength": 10 },
                "team": { "type": ["string", "null"], "maxLength": 5 },
                "rank": { "type": "integer", "minimum": 1, "maximum": 500 },
                "previousRank": { "type": ["integer", "null"], "minimum": 1, "maximum": 500 },
                "tier": { "type": ["integer", "null"], "minimum": 1, "maximum": 100 },
                "insight": { "type": ["string", "null"], "maxLength": 600 }
              }
            }
          }
        }
      }
    }
  }
}
