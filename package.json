{
  "name": "sloppy-potato-fantasy-football",
  "private": true,
  "version": "0.1.5",
  "description": "Fantasy football research, rankings, and local agent runner.",
  "author": "Ryan Smith",
  "type": "module",
  "main": "dist-desktop/main/entry.js",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "pnpm test:ui && pnpm test:worker",
    "test:ui": "vitest run --config vitest.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:runner": "vitest run --config vitest.runner.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply sloppy-potato-football-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply sloppy-potato-football-db --remote",
    "db:migrations:list": "wrangler d1 migrations list sloppy-potato-football-db --local",
    "runner:doctor": "tsx runner/cli.ts doctor",
    "runner:once": "tsx runner/cli.ts once",
    "runner": "tsx runner/cli.ts run",
    "bridge:setup": "tsx runner/setup.ts",
    "desktop:build:shell": "tsup desktop/main/entry.ts --format esm --platform node --external electron --external electron-updater --out-dir dist-desktop/main && tsup desktop/preload.ts --format cjs --platform node --external electron --out-dir dist-desktop && node desktop/scripts/copy-assets.mjs && node desktop/scripts/verify-main-bundle.mjs",
    "desktop:build": "pnpm build && pnpm desktop:build:shell",
    "desktop:dev": "pnpm desktop:build:shell && concurrently -k \"vite\" \"wait-on http-get://127.0.0.1:5173 && cross-env SLOPPY_POTATO_DESKTOP_DEV_URL=http://127.0.0.1:5173 electron .\"",
    "desktop:test": "vitest run --config desktop/vitest.config.ts",
    "desktop:typecheck": "tsc -p desktop/tsconfig.json --pretty false",
    "desktop:pack": "pnpm desktop:build && electron-builder --win nsis portable",
    "desktop:dist": "pnpm desktop:typecheck && pnpm desktop:test && pnpm desktop:pack",
    "check": "pnpm typecheck && pnpm test && pnpm test:runner && pnpm desktop:typecheck && pnpm desktop:test && pnpm build && pnpm desktop:build:shell",
    "deploy": "pnpm check && pnpm db:migrate:remote && wrangler deploy"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "drizzle-orm": "latest",
    "electron-updater": "^6.8.9",
    "exceljs": "4.4.0",
    "hono": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "latest",
    "@cloudflare/vitest-plugin": "latest",
    "@cloudflare/workers-types": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "drizzle-kit": "latest",
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3",
    "jsdom": "latest",
    "tsup": "^8.5.1",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wait-on": "^9.1.0",
    "wrangler": "latest"
  },
  "build": {
    "appId": "com.sloppypotato.fantasyfootball",
    "productName": "Sloppy Potato Fantasy Football",
    "asar": true,
    "files": [
      "dist/client/**/*",
      "dist-desktop/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release-desktop"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ryansm1986",
        "repo": "sloppy-potato-football",
        "releaseType": "release"
      }
    ],
    "win": {
      "icon": "desktop/assets/sloppy-potato-icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
