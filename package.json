{
  "name": "sloppy-potato-fantasy-football",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "pnpm test:ui && pnpm test:worker",
    "test:ui": "vitest run --config vitest.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:runner": "vitest run --config vitest.runner.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply sloppy-potato-football-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply sloppy-potato-football-db --remote",
    "db:migrations:list": "wrangler d1 migrations list sloppy-potato-football-db --local",
    "runner:doctor": "tsx runner/cli.ts doctor",
    "runner:once": "tsx runner/cli.ts once",
    "runner": "tsx runner/cli.ts run",
    "bridge:setup": "tsx runner/setup.ts",
    "check": "pnpm typecheck && pnpm test && pnpm test:runner && pnpm build",
    "deploy": "pnpm check && pnpm db:migrate:remote && wrangler deploy"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "drizzle-orm": "latest",
    "exceljs": "4.4.0",
    "hono": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "latest",
    "@cloudflare/vitest-plugin": "latest",
    "@cloudflare/workers-types": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "drizzle-kit": "latest",
    "jsdom": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  }
}
